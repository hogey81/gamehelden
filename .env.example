# Supabase project (Settings > API). The service role key stays on the server: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials).
YOUTUBE_API_KEY=
# Any long random string. Vercel sends it to /api/cron/sync; set the same value in Vercel.
CRON_SECRET=
# The site's address, for the sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://gamehelden.vercel.app
# Push notifications. Generate once with: npx web-push generate-vapid-keys
# The public key is shown to browsers; the private key stays on the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jouw@emailadres.nl
